# =====================================================
# EduBot Gaya Belajar - Environment Variables Template
# Salin file ini ke .env dan sesuaikan dengan konfigurasi server Anda
# =====================================================

# Port server backend Express (default: 3000)
PORT=3000

# URL microservice Machine Learning Python Flask
ML_URL=http://127.0.0.1:8080

# Konfigurasi Basis Data MySQL (XAMPP Lokal atau Cloud Railway/PlanetScale)
MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=tes_gaya_belajar

# Kunci rahasia untuk menandatangani JWT Token Autentikasi Guru (Ganti dengan string acak aman di produksi)
JWT_SECRET=ganti_dengan_kunci_rahasia_jwt_anda_yang_sangat_panjang_dan_aman_2026

